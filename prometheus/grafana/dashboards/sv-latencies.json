{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Distributions of SV timestamp and software processing latencies",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total number of dropped SV frames during the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(sv_drops_total[$__range]))",
          "legendFormat": "SV drops",
          "refId": "A"
        }
      ],
      "title": "SV drops",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total number of SV frames received during the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null } ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(sv_frames_total[$__range]))",
          "legendFormat": "SV total",
          "refId": "A"
        }
      ],
      "title": "SV total",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Maximum NIC-to-application reception latency observed since the tracer started.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(sv_capture_latency_us_max) / 1000",
          "legendFormat": "Maximum latency",
          "refId": "A"
        }
      ],
      "title": "Maximum latency (ms)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Mean latency from the NIC hardware timestamp to application reception for all SV frames received during the selected rate window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 2,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [ "lastNotNull", "mean", "max" ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum by (appid, svid) (rate(sv_capture_latency_us_sum[$__rate_interval])) / sum by (appid, svid) (rate(sv_capture_latency_us_count[$__rate_interval]))) / 1000",
          "format": "time_series",
          "legendFormat": "{{appid}} / {{svid}}",
          "refId": "A"
        }
      ],
      "title": "Mean NIC-to-reception latency (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Maximum NIC-to-application latency observed during the previous 10 seconds. Millisecond-scale outliers remain visible.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 2,
          "unit": "ms",
          "custom": {
            "axisLabel": "Maximum latency",
            "axisPlacement": "left",
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [ "lastNotNull", "max" ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(1, sum by (le, appid, svid) (increase(sv_capture_latency_us_bucket[10s]))) / 1000",
          "format": "time_series",
          "legendFormat": "{{appid}} / {{svid}}",
          "refId": "A"
        }
      ],
      "title": "Maximum latency over time (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Number of received SV frames for each exact NIC-to-application reception latency since the tracer started. One bar equals one microsecond, including values above 35000 us.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "custom": {
            "axisGridShow": true,
            "axisLabel": "Occurrences",
            "axisPlacement": "left",
            "scaleDistribution": { "type": "log", "log": 10 }
          },
          "decimals": 0,
          "min": 1,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "latency_us_sort"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 24 },
      "id": 5,
      "options": {
        "bucketOffset": 0,
        "bucketSize": 0,
        "barWidth": 1,
        "combine": false,
        "groupWidth": 1,
        "orientation": "vertical",
        "showValue": "always",
        "xField": "latency_us_sort",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
          "xTickLabelSpacing": 100
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
           "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(sum by (latency_us) (sv_capture_latency_us_observations_total) > 0, \"latency_us_sort\", \"00$1\", \"latency_us\", \"([0-9])\"), \"latency_us_sort\", \"0$1\", \"latency_us\", \"([0-9]{2})\"), \"latency_us_sort\", \"$1\", \"latency_us\", \"([0-9]{3})\"), \"latency_us_sort\", \"0$1\", \"latency_us\", \"([0-9]{4})\"), \"latency_us_sort\", \"$1\", \"latency_us\", \"([0-9]{5})\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{latency_us}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": false,
                "field": "latency_us_sort"
              }
            ]
          }
        }
      ],
      "title": "NIC-to-reception distribution by exact microsecond",
      "type": "barchart"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [ "sv", "iec61850", "latency", "histogram" ],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "SV Latency Distributions",
  "uid": "sv-latencies-dashboard",
  "version": 9,
  "weekStart": ""
}
